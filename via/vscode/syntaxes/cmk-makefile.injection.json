{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.makefile.cmk-injection",
  "injectionSelector": "L:source.makefile -comment -string",
  "information_for_contributors": [
    "Enhanced highlighting for plain GNU Makefiles: injects the compose.mk cmk-flavored EXTRAS",
    "(pragmas, ## doc-comments, @# docstrings, import/declare callforms, __dunders__, embed",
    "fences, integral/flow glyphs) on TOP of VSCode's built-in `source.makefile` grammar.",
    "`L:` = low priority, so the base makefile grammar wins and these only add.  Scopes match",
    "the taxonomy in compose.mk/docs/theme/js/prism-cmk.js (shared with the cmk grammar + Prism)."
  ],
  "patterns": [
    { "include": "#cmk-pragma" },
    { "include": "#cmk-divider" },
    { "include": "#cmk-doc-comment" },
    { "include": "#cmk-docstring" },
    { "include": "#cmk-module-call" },
    { "include": "#cmk-dunder" },
    { "include": "#cmk-embed-fence" },
    { "include": "#cmk-capture" },
    { "include": "#cmk-compose-key" },
    { "include": "#cmk-glyphs" }
  ],
  "repository": {
    "cmk-pragma": {
      "name": "meta.preprocessor.pragma.cmk",
      "begin": "^[ \\t]*(#)[ \\t]*(CMK_PRAGMA|cmk_pragma)[ \\t]*(:::)",
      "beginCaptures": {
        "2": { "name": "keyword.control.directive.cmk" },
        "3": { "name": "punctuation.definition.pragma.cmk" }
      },
      "end": "(:::)",
      "endCaptures": { "1": { "name": "punctuation.definition.pragma.cmk" } }
    },
    "cmk-divider": {
      "name": "comment.line.divider.cmk",
      "match": "#*\\x{2591}{4,}"
    },
    "cmk-doc-comment": {
      "name": "comment.line.documentation.double.cmk",
      "match": "^[ \\t]*##.*$"
    },
    "cmk-docstring": {
      "name": "comment.line.documentation.cmk",
      "match": "@#.*$"
    },
    "cmk-module-call": {
      "match": "^((?:[\\w+-]+\\.)*(?:import|declare)(?:\\.[\\w+-]+)*)[ \\t]*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.cmk" }
      }
    },
    "cmk-dunder": {
      "name": "constant.language.dunder.cmk",
      "match": "__(?:main|init|name)__"
    },
    "cmk-embed-fence": {
      "name": "punctuation.definition.embed.cmk",
      "match": "\\x{2AFB}|\\x{1F7B9}"
    },
    "cmk-capture": {
      "name": "keyword.operator.capture.cmk",
      "match": "(?<![<$])<-"
    },
    "cmk-compose-key": {
      "comment": "Docker-compose keys and their values in a .mk file.  This injection runs before the host makefile rules, so the key must also follow a space/tab/open-delimiter -- that is what keeps a column-0 rule head (`build:`) a target.  MIRRORS `#compose-key` in cmk.tmLanguage.json (keep the key list and the value shape in sync).",
      "match": "(?<=[ \\t,({\\[])(annotations|attach|blkio_config|build|cache_from|cache_to|cap_add|cap_drop|cgroup|cgroup_parent|command|configs|container_name|context|cpu_count|cpu_percent|cpu_period|cpu_quota|cpu_rt_period|cpu_rt_runtime|cpu_shares|cpus|cpuset|credential_spec|depends_on|deploy|develop|device_cgroup_rules|devices|dns|dns_opt|dns_search|dockerfile|dockerfile_inline|domainname|driver_opts|endpoint_mode|entrypoint|env_file|environment|expose|extends|external_links|extra_hosts|gpus|group_add|healthcheck|hostname|image|init|ipc|isolation|labels|logging|mac_address|mem_limit|mem_reservation|mem_swappiness|memswap_limit|network_mode|networks|no_cache|oom_kill_disable|oom_score_adj|pid|pids_limit|platform|platforms|ports|post_start|pre_stop|privileged|profiles|pull_policy|read_only|replicas|restart|restart_policy|retries|rollback_config|runtime|secrets|security_opt|services|shm_size|start_interval|start_period|stdin_open|stop_grace_period|stop_signal|storage_opt|sysctls|tmpfs|tty|ulimits|update_config|user|userns_mode|uts|volumes|volumes_from|working_dir)([ \\t]*[:=])[ \\t]*([^\\s,)\\r\\n]*(?:[ \\t]+(?![^\\s,)\\r\\n]*=)(?!\\|[)\\]}])[^\\s,)\\r\\n]+)*)",
      "captures": {
        "1": {
          "name": "keyword.other.compose.cmk"
        },
        "2": {
          "name": "punctuation.separator.key-value.compose.cmk"
        },
        "3": {
          "name": "meta.value.compose.cmk"
        }
      }
    },
    "cmk-glyphs": {
      "patterns": [
        { "name": "keyword.operator.integral.cmk", "match": "\\x{2A16}" },
        { "name": "keyword.operator.flow.cmk", "match": "[\\x{21D0}\\x{1409}\\x{1F844}\\x{1F846}\\x{2B26}\\x{2B25}\\x{174F}]" },
        { "name": "keyword.operator.sigil.cmk", "match": "[\\x{25B0}\\x{27E6}\\x{27E7}\\x{22D9}\\x{22D8}]" }
      ]
    }
  }
}
