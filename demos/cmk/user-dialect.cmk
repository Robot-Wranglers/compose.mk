#!/usr/bin/env -S ./compose.mk cmk run
# Demonstrating user-defined extensions for the CMK -> Makefile compiler.
#
# cmk_dialect ::: [ 
#  ["⏩️", "${stream.stdin} | ${jq} -r"],
#  ["⏪️", "${jb}"], ["this.", "${make} "] ] :::
#
emit: 
	⏪️ key=val

consume:
	⏩️ .key

__main__:
	this.emit | this.consume