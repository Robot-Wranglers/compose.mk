#!/usr/bin/env -S ./compose.mk cmk run
#
# user-dialect.cmk:
#   Define a custom `cmk_dialect` (per-file substitution rules)
#   via a JSON hint, here remapping the JSON-arrow glyphs.
#
# cmk_dialect ::: [ 
#  ["⏩️", "${stream.stdin} | ${jq} -r"],
#  ["⏪️", "${jb}"], ["this.", "${make} "] ] :::
#
emit: 
    ⏪️ key=val

consume:
    ⏩️ .key

__main__:
    this.emit | this.consume