#!/usr/bin/env -S ./compose.mk cmk run
#
# stage-wrapper.cmk:
#   The implicit context-manager
#   form (stage.wrap), with the JSON pushes written in the
#   square-bracket [stream] call-form.
#
#   See the docs for more discussion [1].
#
# USAGE: ./demos/cmk/stage-wrapper.cmk
#
# REFS:
#   [1]: https://robot-wranglers.github.io/compose.mk/stages

# Override the default target used to print the entry-banner
import stage

export CMK_STAGE_BANNER?=io.figlet

__main__: stage.wrap/VALIDATION/project.scan,project.analyze

project.scan:
    stage.push(VALIDATION)["""["results"]"""]

project.analyze:
    stage.push(VALIDATION)["""["other results"]"""]