#!/usr/bin/env -S ./compose.mk cmk run
# kwarg-parsing-2.cmk:
#   Stack `ᝏargs.from_json` + `ᝏargs.from_env` so a target's
#   kwargs are sourced from several places at once.
#
# USAGE: ./demos/cmk/kwarg-parsing-2.cmk
export color=green

emit: 
	🡄 shape=square

ᝏargs.from_json(shape=default1)
ᝏargs.from_env(color=default2 name=Bob)
consume:
	@# Comments in the middle are ok.
	printf "shape=$${shape} color=$${color} name=$${name}\n"

__main__: flux.pipeline/emit,consume
