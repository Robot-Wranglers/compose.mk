#!/usr/bin/env -S ./compose.mk cmk run
#
# kwarg-parsing-2.cmk:
#   Stack `@bind.args(from=json)` + `@bind.args(from=env)` so a target's
#   kwargs are sourced from several places at once.
#
# USAGE: ./demos/cmk/kwarg-parsing-2.cmk
export color=green

emit:
    '''Emits JSON'''
    🡄 shape=square

@bind.args(from=json, shape=default1)
@bind.args(from=env, color=default2 name=Bob)
consume:
    @# Consume JSON
    printf "shape=$${shape} color=$${color} name=$${name}\n"

__main__: flux.pipeline/emit,consume