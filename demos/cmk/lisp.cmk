#!/usr/bin/env -S ./compose.mk cmk compile

'''
The lisp base of kanren.cmk, split out for reuse: an s-expression term algebra
over paren-tokenized word-lists.  A term is a word-list, so lists, dotted pairs,
and nested trees all share one representation; nil is the empty group, an atom is
a single word, and a pair is any other parenthesized group.  span scans a
balanced sub-group by a one-counter paren walk; car / cdr take the first sub-term
and the rest (dotted-tail aware); and wire / unwire fold a nested term to a
vm-safe atom and back.  Import it with `import lisp.cmk as lisp, flat=1`.
'''

open lisp

# m5.slice: a list window with dynamic bounds (m5.at and the accessors live in core).
m5.slice = $(wordlist m5[2],m5[3],m5[1])

# term shapes over paren-tokenized word-lists; nil is the empty group.
lisp.lparen? = $(filter $(m5.tok.lparen),m5[1].first)
lisp.single? = $(if m5[1][2],,1)
lisp.nil?    = $(if $(filter $(m5.tok.lparen),m5[1].first),$(if m5[1][3],,$(filter $(m5.tok.rparen),m5[1][2])),)
lisp.pair?   = $(if lisp.lparen?(m5[1]),$(if lisp.nil?(m5[1]),,1),)
lisp.atom?   = $(if lisp.single?(m5[1]),1,)

# span: token count of the first term, a one-counter scan for a balanced group.
lisp.d    = $(if $(filter $(m5.tok.lparen),m5[1]),m5[2] d,$(if $(filter $(m5.tok.rparen),m5[1]),m5[2].rest,m5[2]))
lisp.grp  = $(if m5[2],m5[1].first lisp.grp(m5[1].rest,lisp.d(m5[1].first,m5[2])),)
lisp.span = $(if lisp.lparen?(m5[1]),$(words x lisp.grp(m5[1].rest,d)),1)

lisp.take  = cmk.m5.slice(m5[2],1,m5[1])
lisp.dropn = $(if m5[1],lisp.dropn(m5[1].rest,m5[2].rest),m5[2])

# car / cdr: first balanced sub-term, and the rest (dotted tail aware).
lisp.car  = lisp.take(lisp.span(m5[1].rest),m5[1].rest)
lisp.cdr  = lisp.cdr2(lisp.dropn(lisp.car(m5[1]),m5[1].rest))
lisp.cdr2 = $(if $(filter .,m5[1].first),lisp.take(lisp.span(m5[1].rest),m5[1].rest),$(m5.tok.lparen) m5[1])

# the wire alphabet as data (char to glyph), in the m5.tok mark namespace escape reads.
$(call m5.declare, \
  m5.tok.lisp_dot.char = ., m5.tok.lisp_dot = Dt, \
  m5.tok.lisp_lp.char = $(m5.tok.lparen), m5.tok.lisp_lp = Lp, \
  m5.tok.lisp_rp.char = $(m5.tok.rparen), m5.tok.lisp_rp = Rp, \
  lisp.marks := lisp_dot lisp_lp lisp_rp)

# wire folds a term to a vm-safe atom, unwire walks the same marks in reverse.
lisp.wire   = $(subst $(space),.,$(strip $(call m5.escape,m5[1],$(lisp.marks))))
lisp.unwire = $(call m5.unescape,$(subst .,$(space),m5[1]),$(call m5.lex.rev,$(lisp.marks)))
lisp.nilw  := Lp.Rp
lisp.consw  = Lp.$(m5[1]).Dt.$(m5[2]).Rp
