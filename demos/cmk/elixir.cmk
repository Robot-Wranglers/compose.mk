#!/usr/bin/env -S ./compose.mk cmk run
# elixir.cmk:
#   Run an inline Elixir snippet inside a container via the
#   `ᝏdocker.bind.script` polyglot idiom.
#
# USAGE: ./demos/cmk/elixir.cmk

# First we pick an image and interpreter for the language kernel.
# Here, iex can work too, but there are minor differences.
elixir.img=elixir:otp-27-alpine
elixir.interpreter=elixir 
elixir=${elixir.img},${elixir.interpreter}

# Now define the elixir code
define hello_world 
import IO, only: [puts: 1]
puts("elixir World!")
System.halt(0)
endef

ᝏdocker.bind.script(img=${elixir.img} entrypoint=${elixir.interpreter})
hello_world:

# $(call docker.bind.container)
# Now show three equivalent ways to run the code inside the container
__main__: hello_world