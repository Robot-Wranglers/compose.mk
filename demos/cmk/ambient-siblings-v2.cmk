#!/usr/bin/env -S ./compose.mk cmk run

# ambient-siblings-v2.cmk: siblings nested two groups deep, addressed by name.

'''
A second take on ambient-siblings.cmk.  There the two boxes are flat and
converge on one top-level channel the parent owns; here they are declared
inside nested ambients and each owns its own mailbox, so a message is addressed
to the recipient by name and no channel is declared anywhere.  alice casts into
bob's mailbox from inside her box, and bob reads his own from inside his.

A `namespace` is a real ambient: it qualifies its children under one name,
joins the ambient registry, parents every child, and offers the door an outward
move lands on.  Nesting composes, so zone holding siblings holding alice is a
three-level place graph that an outward climb walks one level at a time.  Each
box fuses a container with the agent module's Agent, whose inproc transport
makes a cast a push against the recipient's backing stack.

Three seams show through, all recorded in the fidelity doc.  An outward move
into a group relabels without relocating, because a group has no kernel and
only the exit to host.local carries core's escape logic.  The mailbox name is
pinned in source, because a backing stack is per-run keyed.  And the hops boot
unsupervised, because a supervised boot purges the mailbox at its own exit.

Usage: ./demos/cmk/ambient-siblings-v2.cmk   (needs docker)
'''

import log
from agents import Agent
from cmk import container, namespace, class, Dockerfile

Dockerfile base(|
  FROM docker:dind
  RUN apk add -q --update --no-cache coreutils bash make jq
|)

# Pin each mailbox's backing file: the default name is per-run keyed and never
# crosses the box boundary, so siblings would each derive their own.
export events__zone.siblings.alice.mbox := .tmp.events__zone.siblings.alice.mbox.sibv2
export events__zone.siblings.bob.mbox := .tmp.events__zone.siblings.bob.mbox.sibv2

class BoxAgent(bases=Agent,cmk.container)(|
  '''An ambient that is also an agent: a container with its own mailbox.'''
|)

namespace zone(|
  namespace siblings(|
    BoxAgent alice(img=${base.img} entrypoint=bash)(| |)
    BoxAgent bob(img=${base.img} entrypoint=bash)(| |)
  |)
|)

__main__: demo.group demo.emit demo.receive demo.out

demo.group:
  '''the groups are registered ambients that know their members and parent them'''
  log(zone ${sep} holds [$(sort $(filter-out __%,$(zone.__all__)))])
  log(siblings ${sep} holds [$(sort $(filter-out __%,$(zone.siblings.__all__)))])
  log(registered ${sep} [$(call __ambients__.has,zone)] [$(call __ambients__.has,zone.siblings)])
  log(chain ${sep} alice in $(zone.siblings.alice.__ambient_parent__) in $(zone.siblings.__ambient_parent__))

demo.emit:
  '''
  alice casts to bob: ( addressed by recipient name, from inside alice's box )
    The hop boots unsupervised so the mailbox outlives alice's interpreter.
  '''
  log()
  (| CMK_SUPERVISOR=0 ${__cmk__} hop.emit |) in zone.siblings.alice

hop.emit:
  zone.siblings.bob.cast["""type=ping from=$${__ambient__}"""]

demo.receive:
  '''
  bob reads his own mailbox: ( from inside bob's box, nothing shared declared )
  '''
  log()
  (| CMK_SUPERVISOR=0 ${__cmk__} hop.recv |) in zone.siblings.bob

hop.recv:
  log(heard in [$${__ambient__}]:)
  zone.siblings.bob.mbox.dump()

demo.out:
  '''
  alice climbs out: ( one level per hop, box to group to group )
  '''
  log()
  (| CMK_SUPERVISOR=0 ${__cmk__} hop.out |) in zone.siblings.alice

hop.out:
  '''the named form asserts which ambient is being left, and faults when it is not the current one'''
  log(leaving $${__ambient__} for $${__ambient_parent__})
  (| CMK_SUPERVISOR=0 ${__cmk__} hop.out.again |) out zone.siblings.alice

hop.out.again:
  log(leaving $${__ambient__} for $${__ambient_parent__})
  (| echo "  landed in `printenv __ambient__`, whose parent is `printenv __ambient_parent__`" |) out zone.siblings
