#!/usr/bin/env -S ./compose.mk cmk run
#
# platform-lme.cmk: a fake platform-bootstrap lifecycle with observability handlers.
#
# USAGE: ./demos/cmk/platform-lme.cmk

'''
Elaborates the platform demo with LME (logging / metrics / events) handlers.
Ported from demos/platform-lme.mk; see that file and the platform tutorial for
the fuller story.

  1. Infrastructure is configured by the terraform container,
  2. Application is configured by the ansible container,
  3. Both infra/app setup emit JSON events (simulating terraform state output),
  4. JSON from both is routed to all interested handlers.
'''

.DEFAULT_GOAL=platform.setup.observable

compose.import(file=demos/data/docker-compose.platform.yml namespace=▰)

# Map targets to containers.  A public, top-level target.
platform.setup.basic: \
    ▰/terraform/self.infra.setup \
    ▰/ansible/self.app.setup

self.infra.setup:
    '''
    Two "private" targets below, bound to specific containers by the target
    above.  These emit JSON events using the arrow operator.
    '''
    cmk.log(pretending to use terraform..)
    🡄 log="infra setup done" metric=123 \
        event="terraform container task" 
self.app.setup:
    cmk.log(pretending to use ansible..)
    🡄 log="app setup done" metric=456 \
        event="ansible container task"

# Three paired public/private targets representing LME handlers.
# These consume just the parts of JSON they need to use.
# 1. Logging uses the elk container
# 2. Metrics uses the prometheus container
# 3. Events uses the datadog container.
logging: ▰/elk/self.logging
self.logging:
    cmk.log(pretending to push log data somewhere)
    🡆 .log

metrics: ▰/prometheus/self.metrics
self.metrics:
    cmk.log(pretending to use the promtool CLI)
    🡆 .metric

events: ▰/datadog/self.events
self.events:
    cmk.log(pretending to use the datadog CLI)
    🡆 .event

# Bind all handlers into a single pipe.  Send the platform.setup.basic
# output into a handler for each LME backend.
downstream_handlers: flux.pipe.fork/logging,metrics,events
platform.setup.observable: \
    flux.pipeline/platform.setup.basic,downstream_handlers