#!/usr/bin/env -S ./compose.mk cmk run
#
# oop-subcommand.cmk:
#   (Ab)use the namespace search order of the cli.subcommands decorator
#   to simulate inheritance.  The pet CLI searches its namespaces in
#   order, most-derived first, like a method-resolution order: a derived
#   "class" overrides the base, and base-only subs are inherited.
#   Ported from demos/oop-subcommand.mk.
#
# USAGE:
#   ./demos/cmk/oop-subcommand.cmk pet speak
#   ./demos/cmk/oop-subcommand.cmk pet fetch
#   ./demos/cmk/oop-subcommand.cmk pet legs
#   ./demos/cmk/oop-subcommand.cmk pet describe rex
#   ./demos/cmk/oop-subcommand.cmk pet

@cli.subcommands(namespace='.puppy .dog .animal')
pet:
    '''Top-level subcommand entrypoint.'''
    echo hello

# base "class": animal
.animal.legs:; printf '4\n'
.animal.speak:; printf 'generic animal noise\n'
.animal.describe/%:; printf '%s is a kind of animal\n' "${*}"

# "subclass" dog (is-a animal): overrides speak, adds fetch
.dog.speak:; printf 'woof!\n'
.dog.fetch:; printf 'fetches the ball\n'

# "subclass" puppy (is-a dog): overrides speak again
.puppy.speak:; printf 'yip!\n'

__main__: pet