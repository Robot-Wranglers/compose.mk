#!/usr/bin/env -S ./compose.mk cmk run
# events.cmk:
#   Demonstrates the generic EVENT SYSTEM core
#   (demos/cmk/events.mk): seed an `inbox` channel with events, then
#   filter for the logins.  See events.mk for the channel interface.
#
# Once `inbox` is declared a channel it becomes a first-class RECEIVER: its methods are
# called anchorless (`inbox.emit[...]`, `inbox.filter.field_equal/...`) -- no `this.`
# needed.  Plain stdlib targets like `stream.as.log` still take the `this.` anchor.
#
# Other customers of the same core:
#   - demos/cmk/zahn.cmk       -- a multi-exit search loop
#   - demos/cmk/exceptions.cmk -- typed exceptions (deferred dispatch)
#
# USAGE: ./demos/cmk/events.cmk   # filter a channel (find logins)

cmk.declare.channel(namespace=inbox)

inbox.seed:
	@# Pushes a few JSON events onto the channel (newest last).
	inbox.emit["""type=login user=alice"""]
	inbox.emit["""type=logout user=bob"""]
	inbox.emit["""type=login user=carol"""]
	inbox.emit["""type=suspend user=danny"""]

inbox.login_events:
	@# Filters only the login events, newest-first.
	logins ⇐ inbox.filter.field_equal/type,login
	this.stream.as.log["""$${logins}"""]
	
__main__: inbox.seed inbox.login_events
