#!/usr/bin/env -S ./compose.mk cmk run
# script-dispatch-host.cmk:
#   Dispatch a shell script on the host (no container).
#   Ported from demos/script-dispatch-host.mk.
#
# USAGE: ./demos/cmk/script-dispatch-host.cmk

# Look, here's a simple shell script 
define script.sh
set -x
printf "multiline stuff\n"
for i in $(seq 2); do
    echo "Iteration $i"
done
endef

# Directly imports script to target of same name.
compose.import.script(def=script.sh)

__main__: script.sh