#!/usr/bin/env -S ./compose.mk cmk run

# ambient-ladder.cmk: one block, three depths, three kernels (needs docker).

'''
The same block runs at three depths of the ambient tree, and every rung
answers with a different kernel: the host (Darwin or the host linux),
a container (the docker daemon's kernel), and a qemu guest (its own
alpine virt kernel, booted for the occasion).  Nothing about the block
changes between rungs; only the ambient does.  That is the whole
ambient idea in three lines of output, with the kernel names as
witnesses that no clever quoting could fake.

The guest rung follows machine-qemu-exfile.cmk: qemu and a tiny guest
ship inside a container, and the two helper scripts the image needs
(the guest init and the vmexec entrypoint) are file-bananas bound to
the image with dockerfs, so the Dockerfile reads as intent and the
scripts read as scripts.  Qemu and the console name follow the image
arch, so the guest kernel is native on arm64 and x86 hosts alike.  The
guest boots under software emulation where no kvm is offered, so the
last rung takes seconds where the others take milliseconds; the delay
is itself illustrative, since a real kernel is booting.

Usage: ./demos/cmk/ambient-ladder.cmk
'''

import log
from cmk import container, dockerfs, Dockerfile

# qemu_ladder bakes qemu and a tiny guest: alpine virt kernel, plus a busybox initramfs whose init reads its payload off the kernel command line; the init and entrypoint scripts arrive as bound file-bananas below.
Dockerfile qemu_ladder(|
  FROM alpine:3.21
  RUN apk add --no-cache linux-virt busybox-static coreutils
  RUN case "$(uname -m)" in aarch64) apk add --no-cache qemu-system-aarch64;; *) apk add --no-cache qemu-system-x86_64;; esac
  RUN mkdir -p /guest/root/bin /guest/root/proc /guest/root/sys /guest/root/dev
  RUN cp /bin/busybox.static /guest/root/bin/busybox
  RUN cd /guest/root && find . | cpio -o -H newc | gzip > /guest/initramfs.gz
  ENTRYPOINT ["/usr/local/bin/vmexec"]
|)

dockerfs guest_init(bind=qemu_ladder path=/guest/root/init mode=+x)(|
  #!/bin/busybox sh
  /bin/busybox mkdir -p /proc /sys /bin
  /bin/busybox mount -t proc proc /proc
  /bin/busybox mount -t sysfs sys /sys
  /bin/busybox --install -s /bin
  export PATH=/bin
  b64=""
  for tok in $(cat /proc/cmdline); do
    case "$tok" in cmk_payload=*) b64="${tok#cmk_payload=}";; esac
  done
  echo "$b64" | base64 -d > /prog
  echo "___CMK_VM_BEGIN___"
  sh /prog
  echo "___CMK_VM_END___"
  poweroff -f
|)

dockerfs vmexec(bind=qemu_ladder path=/usr/local/bin/vmexec mode=+x)(|
  #!/bin/sh
  prog="$1"
  b64=$(base64 -w0 "$prog")
  if [ "$(uname -m)" = aarch64 ]; then
    out=$(timeout 90 qemu-system-aarch64 -machine virt -cpu max -m 256M -smp 1 -no-reboot -nographic -kernel /boot/vmlinuz-virt -initrd /guest/initramfs.gz -append "console=ttyAMA0 quiet cmk_payload=$b64" 2>/dev/null)
  else
    out=$(timeout 90 qemu-system-x86_64 -machine accel=kvm:tcg -m 256M -smp 1 -no-reboot -nographic -kernel /boot/vmlinuz-virt -initrd /guest/initramfs.gz -append "console=ttyS0 quiet cmk_payload=$b64" 2>/dev/null)
  fi
  echo "$out" | awk '/___CMK_VM_BEGIN___/{f=1;next} /___CMK_VM_END___/{f=0} f'
|)

container box(img=alpine:3.21 entrypoint=sh)(| |)
container vm(img=${qemu_ladder.img} entrypoint=/usr/local/bin/vmexec)(| |)

__main__: qemu_ladder.build rung.host rung.box rung.vm

rung.host:
  '''
  depth zero: ( the host itself )
  '''
  log(host says:)
  (| uname -sr |) in host.local

rung.box:
  '''
  depth one: ( a container shares the docker daemon's kernel )
  '''
  log(container says:)
  (| uname -sr |) in box

rung.vm:
  '''
  depth two: ( a qemu guest boots a kernel of its own )
  '''
  log(vm guest says:)
  (| uname -sr |) in vm
