#!/usr/bin/env -S ./compose.mk cmk run
# zahn.cmk:
#   Zahn's construct as a customer of compose.mk's event system
#   (the `declare.channel` / Events stdlib): a multi-exit search loop whose
#   named exits drive control flow.
#
# zahn.scan seeds candidate events onto the `zahn` channel, takes the
# first matching a (field,value), emits the typed outcome
# (found/exhausted), and dispatches -- the exit selects the
# continuation (recover vs commit).  demos/cmk/exceptions.cmk
# generalizes the same named-exit dispatch to a deferred form.
#
# USAGE:
#   ./demos/cmk/zahn.cmk   # found -> recover, then exhausted -> commit

# Construct the zahn channel (declare.channel ships in compose.mk's stdlib;
# see the Events doc-block there for the operators it generates).
$(call declare.channel,namespace=zahn)

zahn.seed:
	@# a few candidate request events (newest last)
	cmk.log.trace(${@})
	$(call zahn.emit, type=req id=a status=ok)
	$(call zahn.emit, type=req id=b status=error)
	$(call zahn.emit, type=req id=c status=error)

zahn.scan/%:
	@# The loop: find the FIRST seeded event matching <field>,<value>,
	@# emit found{id} (else exhausted), then dispatch -- routing to the
	@# matching named exit below.  Candidates are PURGEd first, so the
	@# drain sees only the outcome.
	@# USAGE: this.zahn.seed && this.zahn.scan/status,error
	cmk.log.trace(${@})
	cmk.log.target(${bold}scan ${sep} ${*})
	m=`this.zahn.first.match.field_equal/${*}` \
	&& this.zahn.purge \
	&& if [ -n "$${m}" ]; then \
		printf 'id=%s' "`echo "$${m}" | ${jq.run} -r .id`" | this.zahn.emit.type/found ; \
	else \
		this.zahn.emit.type/exhausted </dev/null ; \
	fi
	this.zahn.dispatch.by_type

# ── the named exits: each routes to a different continuation
zahn/found:
	@# FOUND exit -> the recovery continuation, carrying the matched id.
	cmk.log.trace(${@})
	v=`echo "$${CMK_EVENT}" | ${jq.run} -r .id` \
	&& this.zahn.recover/$${v}

zahn/exhausted:
	@# EXHAUSTED exit -> the all-clear continuation (a DIFFERENT path).
	cmk.log.trace(${@})
	this.zahn.commit

zahn/%:; cmk.log.trace(${@}) ; cmk.log.target(${red}zahn: unhandled exit ${*})

# Continuations -- reached only via their corresponding exit.
zahn.recover/%:
	@# the FOUND path: act on the failing request <id>.
	cmk.log.trace(${@})
	cmk.log.target(${yellow}recover ${sep} retrying failed request ${bold}${*})
	printf 'recovered=%s\n' "${*}"

zahn.commit:
	@# the EXHAUSTED path: nothing to recover -- proceed.
	cmk.log.trace(${@})
	cmk.log.target(${green}commit ${sep} no failures detected)
	printf 'committed\n'

# ── EXPERIMENT: synchronous exceptions, on the very same primitives ─────────
# demos/cmk/exceptions.cmk DEFERS dispatch to at-exit (a thrown fault stays "in
# flight" until the run ends).  zahn instead dispatches SYNCHRONOUSLY -- so the
# same channel gives inline try/catch: `zahn.raise/<Type>` emits a typed
# exception and drains it RIGHT THEN, so the matching `zahn/<Type>` catch
# (or the `%` fallback, for an uncaught type) runs before control returns.

# throw <Type>, then catch it inline (emit onto the channel + dispatch now).
zahn.raise/%:; cmk.log.trace(${@}) ; this.zahn.emit.type/${*} </dev/null && this.zahn.dispatch.by_type

# a guarded computation: 42/<divisor>, raising DivByZero inline on a 0 divisor.
zahn.divide/%:
	cmk.log.trace(${@})
	if [ "${*}" -eq 0 ]; then this.zahn.raise/DivByZero ; else printf 'divide: 42/%s = %s\n' "${*}" "$$(( 42 / ${*} ))" ; fi

# the CATCH: a synchronous handler for DivByZero (uncaught types hit `zahn/%`).
zahn/DivByZero:
	cmk.log.trace(${@})
	cmk.log.target(${yellow}caught DivByZero ${sep} recovered inline)

# The tour: each scan takes a different named exit --
# status=error -> found -> recover; status=pending -> exhausted -> commit.
__main__:
	this.zahn.seed
	this.zahn.scan/status,error
	this.zahn.seed
	this.zahn.scan/status,pending
	cmk.log.target(cmk.bold()── synchronous exceptions on the same primitives ──)
	this.zahn.divide/7
	this.zahn.divide/0
	this.zahn.raise/Boom
