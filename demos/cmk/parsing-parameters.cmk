#!/usr/bin/env -S ./compose.mk cmk run
#
# parsing-parameters.cmk:
#   Positional-argument parsing in parametric targets via
#   `bind.posargs` (aka `bind.args(from=stem)`): it sets
#   `_1st`/`_2nd`/.../`_head`/`_tail` shell vars from the target's stem,
#   splitting on `,` by default or any delimiter you pass.  Ported from
#   demos/parsing-parameters.mk.
#
# USAGE: ./demos/cmk/parsing-parameters.cmk

__main__: \
    testing.comma_delimited/one,two,three \
    testing.slash_delimited/one/two/three

testing.slash_delimited/%:
    cmk.bind.posargs(/)
    printf "\n1st=$${_1st} 2nd=$${_2nd} 3rd=$${_3rd} 4th=$${_4th}\n"
    printf "\nhead=$${_head} tail=$${_tail}\n"

testing.comma_delimited/%:
    cmk.bind.posargs()
    printf "\n1st=$${_1st} 2nd=$${_2nd} 3rd=$${_3rd} 4th=$${_4th}\n"
    printf "\nhead=$${_head} tail=$${_tail}\n"