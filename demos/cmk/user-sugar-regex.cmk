#!/usr/bin/env -S ./compose.mk cmk run
# user-sugar-regex.cmk:
#   Extending the compiler with a custom fenced-block syntax via REGEX sugar markers.
#
#   Sugar markers are matched as regexes (unlike dialect rules, which are literal), and that
#   is a feature: ONE rule opens a whole FAMILY of blocks and can ANCHOR them to the start of
#   a line.  Below, `^@@` opens a block named by whatever follows it, `^@@end` closes it, and
#   the `^` guarantees a stray `@@` sitting inside a recipe never false-triggers a block.  A
#   pure-literal marker could do neither -- you'd need one rule per name and no way to anchor.
#
#   USAGE: ./demos/cmk/user-sugar-regex.cmk
#
# cmk_dialect ::: [["this.","${make} "]] :::
# cmk_sugar ::: [["^@@","^@@end","$(call polyglot.__import__.__AS__,__NAME__,__WITH__)"]] :::

# Two `@@<name>` blocks -- the SAME rule matches both names (the family) -- each bound to the
# host python3 interpreter declared below, so they actually run.
@@hello
print("hello from a @@-fenced python block")
@@end with bind=hostpy as target

@@compute
print("1 + 2 + ... + 9 =", sum(range(10)))
@@end with bind=hostpy as target

# A one-line host interpreter: run the block's staged file with python3.
hostpy/%:; python3 ${*}

__main__:
	this.hello
	this.compute
	@# Anchoring in action: the `^` in `^@@` means this literal `@@hello`, sitting mid-recipe,
	@# is plain text -- it does NOT open a block.
	@echo "inert: the text @@hello here is just a string"
