#!/usr/bin/env -S ./compose.mk cmk run
# exceptions.cmk -- typed exceptions as a CUSTOMER of compose.mk's event
# system (the `declare.channel` / Events stdlib).  An exception is just an EVENT
# on the `fault` channel; the only things that make it an "exception":
#   - emit also FAILS the caller (`exit 1`),
#   - dispatch is deferred to AT-EXIT (vs Zahn's synchronous dispatch),
#   - each event is shown with an FTA-kind glyph.
#
# A target "raises" via `cmk.fault.throw(<type>, <k=v ...>)`: it emits
# `{type, target, file, ...meta}` onto the channel and exits 1.  A
# SWALLOWED failure leaves the event IN FLIGHT; at end of run the at-exit
# `fault.dispatch.by_type` drains the channel and routes each by `.type` to
# `fault/<Type>:` -- or the `fault/%:` fallback.  Routing
# IS make's rule precedence (explicit beats pattern), so NO registry.
#
# `kind` is drawn from Fault Tree Analysis's event taxonomy:
#   - basic: a root component/tool failure (●)
#   - external: an expected occurrence (⌂)
#   - undeveloped: unknown / no info (◆)
#   - conditioning: a gate / precondition (⬭)
#
# USAGE:
#   ./demos/cmk/exceptions.cmk            # tour: dispatched at exit
#   ./demos/cmk/exceptions.cmk demo.boom  # one UNCAUGHT -> nonzero exit

# Exceptions defer dispatch to AT-EXIT.  Register the drain FIRST, then construct
# the channel: declare.channel generates fault.* and auto-registers fault.purge
# -- which (via `+=`) thus lands AFTER the drain, so the stack is dispatched
# before it is removed.
export CMK_AT_EXIT_TARGETS += fault.dispatch.by_type
$(call declare.channel,chan=fault)

# fault.log: red fault logger (a red replacement-character glyph instead of
# log.io's green I/O glyph).
fault.log=$(call log, ${yellow}${bold}¿${no_ansi}${red} $(1))

# fault.throw(<type>[,<k=v meta>]) -- raise: emit a typed fault onto the channel
# (always recording the calling `target` and source `file`), then FAIL.
# = fault.emit + `exit 1`.
fault.throw=$(call fault.emit, type=$(strip $(1)) target=$(@) file=${__file__} $(if $(filter-out undefined,$(origin 2)),$(strip $(2)))) && exit 1

# fault.show -- per-event presentation shared by EVERY handler (each opens with
# `$(call fault.show)`): emit the handler's trace line, then an FTA glyph chosen
# from `.kind` plus a header.  Folding log.trace in here keeps the handlers
# trace-logged without an explicit per-handler line.  (The dispatcher already
# narrates the event JSON; $CMK_EVENT is exported by it.)
fault.show=$(call log.trace, ${@}) ; case `echo "$${CMK_EVENT}" | ${jq.run} -r '.kind // "?"'` in basic) s=● ;; external) s=⌂ ;; undeveloped) s=◆ ;; conditioning) s=⬭ ;; *) s=• ;; esac ; $(call fault.log,$${s} Exception ${sep} ${bold}`echo "$${CMK_EVENT}" | ${jq.run} -r .type`)

# fault.guarded: a POSTFIX catch decorator (default mode `||`, so a bare
# `ᝏfault.guarded` runs ONLY when the body FAILS); it captures the failed
# subprocess's exit code and re-throws it as a typed SubprocessFault.
# WARNING: bind.fault.guarded MUST stay a brace group -- `&&`/`||` are
# equal-precedence, else the catch leaks onto the success path.
bind.fault.guarded.postfix_mode := ||
bind.fault.guarded={ rc=$$? ; $(call log.target,${dim}${yellow} caught abnormal exit ${sep} ${dim}code=$${rc} ${sep} ${dim}throw=SubprocessFault) ; $(call fault.throw,SubprocessFault,kind=external code=$${rc}) ; }

# ── handlers: `fault/<Type>:`, routed by make precedence ──────
fault/DivZero:
	@$(call fault.show)
	cmk.fault.log(${yellow}caught DivZero)

fault/NotFound:
	@$(call fault.show)
	cmk.fault.log(${yellow}caught NotFound)

fault/Inner:
	@# a handler may itself raise; the drain then dispatches that too.
	@$(call fault.show)
	cmk.fault.log(${yellow}caught Inner ${sep} rethrow=Wrapped)
	cmk.fault.throw(Wrapped, kind=conditioning)

fault/Wrapped:
	@$(call fault.show)
	cmk.fault.log(${yellow}caught Wrapped (re-thrown by a handler))

fault/SubprocessFault:
	@$(call fault.show)
	cmk.log.target(${yellow}caught SubprocessFault ${sep}: unexpected tool exit)

fault/%:
	@# fallback: no handler for this type.  NB: no `exit` -- a handler
	@# at supervisor-exit can't change the process code.
	@$(call fault.show)
	cmk.fault.log(${bold}UNHANDLED EXCEPTION: ${*} ${sep} no handler registered)

# ── demo throwers (`demo.*` = app code that raises) ──────────────────
demo.div:
	cmk.log.target(div -> raise DivZero)
	cmk.fault.throw(DivZero, kind=conditioning)

demo.lookup:
	cmk.log.target(lookup -> raise NotFound)
	cmk.fault.throw(NotFound, kind=external)

demo.nested:
	cmk.log.target(raise Inner (its handler re-throws Wrapped))
	cmk.fault.throw(Inner, kind=basic)

demo.boom:
	cmk.log.target(raise BOOM (no handler))
	cmk.fault.throw(BOOM, kind=undeveloped)

ᝏfault.guarded
demo.guarded:
	@# A subprocess FAULT (nonzero exit, no type) bridged to a typed
	@# fault: ᝏfault.guarded catches the body's failure and re-throws
	@# it as a SubprocessFault.
	@# NB: the tool runs as a RAW subprocess so its exact code survives.
	cmk.log.target(simulating random command failure with exit code)
	sh -c 'exit 3'

# The tour: raise several, swallowing each failure (`|| true`) so every
# event stays in flight; the at-exit hook drains and dispatches them all.
__main__:
	cmk.log.target(${bold} typed exceptions via a global at-exit handler)
	this.demo.div </dev/null || true
	this.demo.lookup </dev/null || true
	this.demo.nested </dev/null || true
	this.demo.guarded </dev/null || true
	this.demo.boom </dev/null || true

testing: demo.boom
