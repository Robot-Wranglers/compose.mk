#!/usr/bin/env -S ./compose.mk cmk run
# golang.cmk: embed inline Go via the code module.

'''
Cross-build inline Go in a dockerized toolchain; go.mod auto-generates.
'''

import code

code.golang hello(|
  package main
  import ("fmt"; "os")
  func main() {
    who := "world"
    if len(os.Args) > 1 { who = os.Args[1] }
    fmt.Println("hi " + who + "!")
  }
|)

# a hand-written go.mod, to override the generated default
gomod(|
  module greeter
  go 1.24
|)

__main__: hello hello/you run.inline run.custom

run.inline:
  '''run.inline: call the code.golang.lambda macro directly.'''
  code.compiled.lambda(lang=code.golang src=hello args=inline)

run.custom:
  '''run.custom: build with the hand-written go.mod (mod= override).''' 
  code.compiled.lambda(lang=code.golang src=hello mod=gomod)


