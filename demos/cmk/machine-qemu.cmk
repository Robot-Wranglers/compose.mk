#!/usr/bin/env -S ./compose.mk cmk run

# machine-qemu.cmk: a virtual machine as a cmk machine (needs docker)

'''
A machine is any run context a block executes in.  With no image the run hook is
a host command; with an image it is a container.  Here the image goes one level
further: its entrypoint (vmexec) boots a tiny guest under qemu, runs the fed
program in the guest, and prints the guest's stdout.  So `in vm` means "in a real
kernel", not just "in a container".  The container-as-machine demos stop at the
container (see container-eval.cmk); this one runs one hop deeper.

The nesting is the whole idea:
  container machine:  program -> [ image ] -> interpreter
  vm machine:         program -> [ image running qemu ] -> guest kernel -> sh

The feed discipline is unchanged.  feed=file (the default) materializes the block
to a file and hands it to vmexec, which base64s it onto the guest kernel command
line, where the guest init decodes and runs it.  Everything qemu-specific lives
in the image and vmexec, never in a machine class, so a different backend (a
vagrant box, a vmware vmx) would be a different entrypoint, not a reshaped machine.

qemu ships inside the image, so the host needs no qemu, only docker.  The guest
runs under software emulation (tcg) by default, so no host kvm is required and the
demo stays portable; qemu uses kvm automatically where a `--device=/dev/kvm`
passthrough offers it, cutting boot to about a second.

  usage: ./demos/cmk/machine-qemu.cmk
'''

from cmk import container, dsl, Dockerfile

# qemu_runner bakes qemu, a tiny guest (alpine virt kernel + a busybox initramfs whose init reads its payload off the kernel command line), and the vmexec entrypoint that drives a one-shot boot.
Dockerfile qemu_runner(|
  FROM alpine:3.21
  RUN apk add --no-cache qemu-system-x86_64 linux-virt busybox-static coreutils
  RUN mkdir -p /guest/root/bin /guest/root/proc /guest/root/sys /guest/root/dev
  RUN cp /bin/busybox.static /guest/root/bin/busybox
  RUN cat > /guest/root/init <<'CMKEOF'
  #!/bin/busybox sh
  /bin/busybox mkdir -p /proc /sys /bin
  /bin/busybox mount -t proc proc /proc
  /bin/busybox mount -t sysfs sys /sys
  /bin/busybox --install -s /bin
  export PATH=/bin
  b64=""
  for tok in $(cat /proc/cmdline); do
    case "$tok" in cmk_payload=*) b64="${tok#cmk_payload=}";; esac
  done
  echo "$b64" | base64 -d > /prog
  echo "___CMK_VM_BEGIN___"
  sh /prog
  echo "___CMK_VM_END___"
  poweroff -f
  CMKEOF
  RUN chmod +x /guest/root/init
  RUN cd /guest/root && find . | cpio -o -H newc | gzip > /guest/initramfs.gz
  RUN cat > /usr/local/bin/vmexec <<'CMKEOF'
  #!/bin/sh
  prog="$1"
  b64=$(base64 -w0 "$prog")
  out=$(timeout 60 qemu-system-x86_64 -machine accel=kvm:tcg -m 256M -smp 1 -no-reboot -nographic -kernel /boot/vmlinuz-virt -initrd /guest/initramfs.gz -append "console=ttyS0 quiet cmk_payload=$b64" 2>/dev/null)
  echo "$out" | awk '/___CMK_VM_BEGIN___/{f=1;next} /___CMK_VM_END___/{f=0} f'
  CMKEOF
  RUN chmod +x /usr/local/bin/vmexec
  ENTRYPOINT ["/usr/local/bin/vmexec"]
|)

# vm: a container machine whose entrypoint is vmexec, so a block in vm is a shell program the guest runs.
container vm(img=compose.mk:qemu_runner entrypoint=/usr/local/bin/vmexec)(| |)

# vmsh: a dsl backed by the vm machine, for multi-line guest programs a single recipe line cannot hold.
dsl vmsh(machine=vm)(| |)

vmsh probe(|
  echo "guest kernel:"
  uname -sr
  echo "guest sees these cpus:"
  grep -c ^processor /proc/cpuinfo
  echo "guest uptime seconds:"
  cut -d. -f1 /proc/uptime
|)

__main__: qemu_runner.build one_liner multi_line

one_liner:
  ''' a single-line block, run inside the guest via in '''
  (| echo "hello from inside a qemu guest"; uname -a |) in vm

multi_line:
  '''
  invoke the named instance: probe() routes through the vm machine, boots the
  guest, runs the whole shape in it, and returns the guest's stdout
  '''
  probe()
