#!/usr/bin/env -S ./compose.mk cmk run

# dockerfs-fluent.cmk: dockerfs.cmk restated as a fluent chain (staged grammar; faults at compile today)

'''
In `dockerfs greet(bind=greeter_img path=.. mode=..)(| .. |)` the declared name
`greet` is never referenced again: it exists only so registration has a def to
hang the body on, and `bind=` repeats the image on every file.  Both are
redundant in a chain hung off the image itself, where the receiver supplies the
binding and the compiler can supply a gensym name:

  Dockerfile IMG(| .. |).dockerfs(path=.. mode=..)(| .. |).dockerfs(..)(| .. |)

That is what this demo writes.  It is well-defined, but it is staged grammar:
the form mixes a module-level ctor declaration, a chained call with kwargs, and
a second banana body, and today the trailer after a declaration's `|)` is read
as a compile-time postfix treatment, so this file faults at compile with a
grammar fault.  The wall is pinned as xfails in tests/test_compiler_cmk.py
(fluent declaration chains section); the working named form is
demos/cmk/dockerfs.cmk.

  usage: ./demos/cmk/dockerfs-fluent.cmk   (currently faults; see above)
'''

from cmk import container, dockerfs, Dockerfile
import log

# One chain replaces the three named declarations in dockerfs.cmk: the receiver implies each binding.
Dockerfile greeter_img(|
  FROM alpine:3.21
  RUN apk add --no-cache jq
  ENTRYPOINT ["/usr/local/bin/greet"]
|).dockerfs(path=/usr/local/bin/greet mode=+x)(|
  #!/bin/sh
  who=$(jq -r .who /etc/greeter.json)
  punct=$(jq -r .punct /etc/greeter.json)
  echo "hello, ${who}${punct} (from $(uname -s), pid $$)"
|).dockerfs(path=/etc/greeter.json mode=0644)(|
  {"who": "dockerfs", "punct": "!"}
|)

# The machine that runs the built image, so a call reaches the bound entrypoint.
container greeter(img=compose.mk:greeter_img)(| |)

# The same image with the entrypoint overridden, for looking at what landed.
container greeter_cat(img=compose.mk:greeter_img entrypoint=cat)(| |)

demo.render:
  '''Show the folded recipe without building: base line first, then the injected copy and chmod pairs.'''
  log(${bold}rendered Dockerfile${no_ansi} (bound files folded in):)
  greeter_img.render()

demo.build:
  '''Build the image, which materializes both bound files into a private context.'''
  log(${bold}building${no_ansi} compose.mk:greeter_img)
  greeter_img.build()

demo.run:
  '''Run the entrypoint the bound files supplied, then read the bound config back out.'''
  log(${bold}entrypoint${no_ansi} (the +x bound file):)
  greeter()
  log(${bold}config${no_ansi} (the 0644 bound file, as it landed):)
  greeter_cat(/etc/greeter.json)

__main__: demo.render demo.build demo.run
