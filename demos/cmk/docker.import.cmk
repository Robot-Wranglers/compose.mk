#!/usr/bin/env -S ./compose.mk cmk run
#
# docker.import.cmk:
#   Import docker images (a stock image and one from an inlined
#   Dockerfile), then drive the scaffolded targets that are
#   generated for each.  Ported from demos/docker.import.mk.
#
# USAGE: ./demos/cmk/docker.import.cmk

# Import a stock image
docker.import(namespace=debian img=debian/buildd:bookworm)

# Import an image described by a local Dockerfile
docker.import(namespace=mycontainer file=demos/data/Dockerfile)

__main__: test.stock_image test.local_image

test.local_image: mycontainer.build
    '''
    Test dispatch and low-level targets for the locally defined
    image.  Note that we have to build it before we can use it.
    '''
    ${make} mycontainer.dispatch/flux.ok
    entrypoint=sh cmd='-c "echo hello-world"' ${make} mycontainer

test.stock_image:
    '''Test dispatch and low-level targets for the stock image.'''
    ${make} debian.dispatch/flux.ok
    entrypoint=sh cmd='-c "echo hello-world"' ${make} debian
