#!/usr/bin/env -S ./compose.mk cmk run
# bind-file.cmk:
#   Bind an external script file to a target, run in a container.
#
# The `ᝏpolyglot.bind.file(...)` decorator binds the file + image + interpreter to
# the target below it (here `__main__`), so running the demo runs the file.
# Ported from demos/bind-file.mk.
#
# USAGE: ./demos/cmk/bind-file.cmk

kwargs=\
	file=demos/data/test-file.py \
	img=python:3.11-slim-bookworm \
	entrypoint=python

ᝏpolyglot.bind.file(${kwargs})
__main__: