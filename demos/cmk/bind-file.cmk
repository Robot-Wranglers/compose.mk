#!/usr/bin/env -S ./compose.mk cmk run
#
# bind-file.cmk:
#   Bind an external script file to a container and run it as a target.
#   A code-object sources its body from `file=`, binds to a python container,
#   and becomes a prerequisite of `__main__`, so running the demo runs the
#   file inside the image.
#   Ported from demos/bind-file.mk.
#
# USAGE: ./demos/cmk/bind-file.cmk

code myscript(file=demos/data/test-file.py img=python:3.11-slim-bookworm entrypoint=python)(| |)

__main__: myscript
