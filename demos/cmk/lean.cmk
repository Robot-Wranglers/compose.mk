#!/usr/bin/env -S ./compose.mk cmk run
#
# lean.cmk: drive the Lean 4 theorem prover from inline code-objects.
#
# USAGE: ./demos/cmk/lean.cmk

'''
A Dockerfile instance builds lean4 (baked ENTRYPOINT `lean`); `Lean.polyglot` creates a theorem
(type-checked by `lean <file>`), and a second view of the image (base `cmd=--run`) creates a
script (executed by `lean --run <file>`).  Ported from demos/lean.mk.
See: https://leanprover-community.github.io/install/debian.html
'''

from cmk import machine, Dockerfile

Dockerfile Lean(|
  FROM ${IMG_DEBIAN_BASE:-debian:bookworm-slim}
  SHELL ["/bin/bash", "-x", "-c"]
  RUN apt-get -qq update && apt-get install -qq -y git make curl sudo
  RUN curl -sSf https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh > /usr/local/bin/elan-init.sh
  RUN bash /usr/local/bin/elan-init.sh -y --default-toolchain leanprover/lean4:v4.17.0
  RUN cp /root/.elan/bin/lean /usr/local/bin
  RUN cp /root/.elan/bin/lake /usr/local/bin
  ENV PATH="$PATH:/root/.elan/bin/"
  RUN lean --help
  RUN lake new default
  RUN cd default && printf '[[require]]\nname = "mathlib"\nscope = "leanprover-community"' >> lakefile.toml
  RUN cd default && lake update && lake build
  RUN elan --version; lean --version; leanc --version; lake --version;
  ENTRYPOINT ["lean"]
|)

# A theorem, type-checked by `lean <file>`.
Lean.polyglot my.theorem(|
  section
  open Classical
  example : A ∨ ¬ A := by
    apply byContradiction
    intro h1
    have h2 : ¬ A := by
      intro h3
      have h4 : A ∨ ¬ A := Or.inl h3
      show False
      exact h1 h4
    have h5 : A ∨ ¬ A := Or.inr h2
    show False
    exact h1 h5
  end
|)

# A script, executed by `lean --run <file>` -- the baked ENTRYPOINT stays `lean`; `--run` is just a
# base cmd the code-object file appends to.  A second machine view of the built image supplies it.
machine Lean.script(| img=$(Lean.img) cmd=--run |)
Lean.script.polyglot my.script(|
  def main : IO Unit := IO.println "Hello, world!"
|)

# Build (cached) the lean image, then run the theorem + script.
__main__: my.theorem my.script
