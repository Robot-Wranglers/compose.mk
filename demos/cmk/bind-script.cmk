#!/usr/bin/env -S ./compose.mk cmk run
#
# bind-script.cmk:
#   Bind a shell script to a target, dispatched in a compose service.  Two
#   equivalent idioms: a recipe body `(| .. |) in <service>` (the `in`
#   machine-algebra), and the explicit `@compose.bind.script(svc=..)` decorator.
#   Ported from demos/bind-script.mk.
#
# USAGE: ./demos/cmk/bind-script.cmk

compose.import(file=demos/data/docker-compose.yml)

# Script-in-service using the `in` machine-algebra
script1.sh:
  (| echo hello container `hostname` |) in alpine

# Script-in-service using the decorator idiom
@compose.bind.script(svc=debian)
script2.sh:
script2.sh(|
	echo hello container `hostname`
|)

# The `in`-form (script1.sh) runs the body in the service directly.  The decorator
# form (script2.sh) additionally survives re-entrant dispatch: it runs from the
# container whether called from the host OR from inside the container (the
# `debian.dispatch/` round-trip below re-enters and still runs correctly).
__main__: \
    script1.sh \
    script2.sh debian.dispatch/script2.sh
