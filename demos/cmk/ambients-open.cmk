#!/usr/bin/env -S ./compose.mk cmk run
#
# ambients-open.cmk: the module-level side of the mobile ambient calculus -- opening
#   an ambient, i.e. dissolving its boundary so members merge into the namespace.
#
# USAGE: ./demos/cmk/ambients-open.cmk

'''
A module is an ambient.  `open` and the star forms dissolve it (merge flat);
`import .. as` mounts it nested.  The star has two shapes: `*(| .. |)` splices one
line of verbatim make, `*[| .. |]` encapsulates a whole indented block of targets
and explodes it flat.  For the recipe-level machine algebra (`in` / `out` / `|` / `+`),
see ambients.cmk.

Ported from Cardelli & Gordon, Mobile Ambients (ETAPS/FoSSaCS 1998):
http://lucacardelli.name/Papers/MobileAmbientsETAPS98.A4.pdf
'''

# `open <module>` dissolves the module's boundary, merging `probe.*` verbatim into
# this file's namespace (callable unqualified) -- Cardelli-Gordon `open n`.  A `/`-path
# opens a file, a bare name opens a plugin; both lower to
# `$(call import.module, file=.. flat=1)`.
open demos/data/ambients.probe.cmk
# bind the `constructor` declaration keyword bare (docs/compiler prelude)
from cmk import namespace

demo.open:
  cmk.log(open <module> -- probe.* dissolved into scope:)
  this.probe.temp
  this.probe.status

# `*(| body |)` is the inline dual of `open`: it splices an anonymous block's body flat
# into this namespace -- no boundary, no name.  A leading ctor composes: it runs the block
# through the ctor first, then dissolves.  Bare `*(||)` is the ctor=identity case.
*(|
  inline.probe:; @printf "  probe.temp    -> 21.4C (inline ambient)\n"
|)

demo.inline:
  cmk.log(inline ambient -- dissolved flat, members callable:)
  this.inline.probe

# `*[| body |]` is the cooked, multi-line dual: it holds a whole block of tab-recipe
# targets authored at 2-space indent, dedents it, and explodes the members flat into
# scope.  This is the encapsulate-then-explode pattern compose.mk uses in its `__hosted__`
# region to group the `machine` / `flux.*` families.  Author targets at +2, recipes at +4.
*[|
  sensor.calibrate:
    cmk.log(calibrating -- offset applied)
    echo "  sensor.offset -> +0.3C"

  sensor.report:
    cmk.log(reading sensors:)
    echo "  sensor.temp   -> 21.7C (calibrated)"
|]

demo.explode:
  cmk.log(*[| .. |] -- block dedented + exploded flat, callable:)
  this.sensor.calibrate
  this.sensor.report

# `namespace` is a kind for names, bound bare by the `from cmk import namespace` above (`cmk.namespace`
# qualified).  `namespace NAME[| body |]` qualifies the body's heads under `NAME.` and
# threads the enclosing `${__name__}`, so nested blocks compose to `tier1.tier2.foo`.

# `namespace *(| .. |)` == `*(| .. |)`: the `namespace` word rides in as `kind=namespace`,
# which has no `.dissolve`, so `ambient.dissolve` falls back to inline eval (a flat
# splice).
namespace *(|
  ns.probe:; @printf "  ns.probe -> via namespace *(||), same as *(||)\n"
|)

demo.ns.star:
  cmk.log(namespace *(||) -- rides ambient.dissolve inline, == *(||):)
  this.ns.probe

# Two levels: bare heads qualify to `tier1.tier2.*`.  The inner `namespace tier2` fires
# inside `define tier1`, after tier1 pushes `${__name__}` -- the closure.
namespace tier1[|
  namespace tier2[|
    foo:; @printf "  ran %s\n" "$@"
    report:
      @printf "  multi-line recipe, target %s\n" "$@"
      @printf "  (a second recipe line, still tab-indented)\n"
  |]
|]

demo.ns.nested:
  cmk.log(nested namespace -- bare heads, all qualified to tier1.tier2.*:)
  this.tier1.tier2.foo
  this.tier1.tier2.report
  cmk.log(reflection: tier1.tier2.__name__ = ${tier1.tier2.__name__})

# `import <module> as sensors` does not dissolve -- it mounts the module as a nested
# ambient under `sensors.*` (boundary intact).  Lowers to
# `$(call import.module, file=.. namespace=sensors)`.
import demos/data/ambients.probe.cmk as sensors

demo.mount:
  cmk.log(import .. as -- ambient mounted, reach via sensors.*:)
  sensors.probe.temp()
  sensors.probe.status()

# The open algebra: `open` / `*(| .. |)` / `*[| .. |]` dissolve (merge flat);
# `ctor *(| .. |)` constructs then dissolves; `import .. as N` mounts (nested, boundary
# intact).  Dissolving crosses a boundary; mounting keeps it.
__main__: demo.open demo.inline demo.explode demo.ns.star demo.ns.nested demo.mount
