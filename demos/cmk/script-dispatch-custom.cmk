#!/usr/bin/env -S ./compose.mk cmk run
# script-dispatch-custom.cmk:
#   Dispatch a shell script inside a local, embedded
#   container.  Ported from demos/script-dispatch-custom.mk.
#
# USAGE: ./demos/cmk/script-dispatch-custom.cmk

⫻ Dockerfile.my_container
FROM debian/buildd:bookworm
# .. other customization here ..
⫻

⨖ example-1.sh
echo hello `hostname` at `uname -a` 
⨖ with img=my_container as local_context

export var1=hello-world

⨖ example-2.sh
echo variable exported: ${var1:-not set}
⨖ with img=my_container env='var1' quiet=1 as local_context

__main__: example-1.sh example-2.sh
