#!/usr/bin/env -S ./compose.mk cmk run
#
# script-dispatch-custom.cmk:
#   Dispatch a shell script inside a local, embedded container built from an
#   inline Dockerfile.  A recipe body `(| .. |) in <container>` runs in that
#   locally-built image; an env var rides in via the `{env=..}` channel.
#   Ported from demos/script-dispatch-custom.mk.
#
# USAGE: ./demos/cmk/script-dispatch-custom.cmk

from cmk import Dockerfile

Dockerfile my_container(entrypoint=bash)(|
    FROM debian/buildd:bookworm
    # .. other customization here ..
|)

example-1.sh:
  (| echo hello `hostname` at `uname -a` |) in my_container

export var1=hello-world

example-2.sh:
  (| echo variable exported: ${var1:-not set} |) in my_container {env=var1}

__main__: example-1.sh example-2.sh
