#!/usr/bin/env -S ./compose.mk cmk run
#
# inlined-composefile.cmk:
#   Embed a compose file inline; its services scaffold dispatch targets.
#
# USAGE: ./demos/cmk/inlined-composefile.cmk

'''
Embed a docker-compose file inline as a string module.  Each declared
service scaffolds dispatch targets automatically, so a private target can
be run inside any service by name.  The styles below show the equivalent
prereq and target-body forms.  Ported from demos/inlined-composefile.mk.
'''

compose.import.string inlined.services(|
services:
  alice: &base
    hostname: alice
    build:
      context: .
      dockerfile_inline: |
        FROM ${IMG_DEBIAN_BASE:-debian:bookworm-slim}
        RUN apt-get update -qq && apt-get install -qq -y make
    entrypoint: bash
    working_dir: /workspace
    volumes:
      - ${PWD}:/workspace
      - ${DOCKER_SOCKET:-/var/run/docker.sock}:/var/run/docker.sock
  bob:
    <<: *base
    hostname: bob
    build:
      context: .
      dockerfile_inline: |
        FROM ${IMG_ALPINE_BASE:-alpine:3.21.2}
        RUN apk add -q --update --no-cache \
          coreutils build-base bash
|)

self.internal_task:
    ''' A private target, intended to run inside containers. '''
    cmk.log(Running inside ${red}`hostname`)

__main__: alice.dispatch(self.internal_task) \
  bob.dispatch(self.internal_task)
    '''
    Dispatch demo: run the private target inside each service, using
    call-form syntax that looks like function-invocation.
    '''

alternate_style1:
    '''
    Equivalent to __main__, using a target body instead of prereqs.
    Inside the body, the `this.` prefix is required.
    '''
    this.alice.dispatch(self.internal_task)
    this.bob.dispatch(self.internal_task)

alternate_style2: alice.dispatch/self.internal_task \
  bob.dispatch/self.internal_task
    '''
    More "classic" style in pure Makefile; equivalent to __main__, with
    the prereqs doing the work (no imperative recipe).
    '''

alternate_style3:
    '''
    Equivalent to alternate_style1, using a target body; just trading
    the `this.` prefix for an explicit make invocation.
    '''
    ${make} alice.dispatch/self.internal_task
    ${make} bob.dispatch/self.internal_task
