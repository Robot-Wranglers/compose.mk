#!/usr/bin/env -S ./compose.mk cmk run
#
# import-file.cmk:
#   Import an external script file as a namespaced, runnable code-object.
#   A code-object can source its body from a `file=` instead of an inline
#   `(| .. |)` block; binding it to a container (img= + entrypoint=) makes
#   running the target run that file inside the image.
#   Ported from demos/import-file.mk.
#
# USAGE: ./demos/cmk/import-file.cmk

export foo=val1
export bar=val2

# A file-sourced code-object bound to a python container.  The empty `(| |)`
# body is just a placeholder: the real content comes from `file=`.
code testing(file=demos/data/test-file.py img=python:3.11-slim-bookworm entrypoint=python cmd=-O env='foo bar')(| |)

__main__: testing
