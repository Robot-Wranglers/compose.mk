#!/usr/bin/env -S ./compose.mk cmk run
# import-file.cmk:
#   Import an external script file as a new, namespaced target.
#   Ported from demos/import-file.mk.
#
# USAGE: ./demos/cmk/import-file.cmk

export foo=val1
export bar=val2

kwargs= \
	file=demos/data/test-file.py \
	img=python:3.11-slim-bookworm \
	entrypoint=python cmd='-O' \
	namespace=testing \
	env='foo bar'

polyglot.import.file(${kwargs})

__main__: testing