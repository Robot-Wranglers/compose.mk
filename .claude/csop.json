// CSOP config for compose.mk -- inert unless/until the csop plugin is installed here.
{
  // racc: enabled per matt, 2026-08-24, after shell heredocs routed core edits past the hyg and techwrite gates.
  "racc": {
    "default_enabled": true
  },

  "freeze": {
    "default_enabled": true,
    "frozen": [
      {
        "path": "via/pip/_plugins",
        "mode": "no-touch",
        "why": "Materialized, gitignored BUILD ARTIFACT -- via/pip/setup.py copies it out of the .cmk submodule at build time. Editing it is overwritten on the next build; even READING it invites treating a stale copy as source (divergence/data loss).",
        "use": ".cmk/"
      },
      {
        "path": ".cmk/compose.mk",
        "mode": "no-touch",
        "why": "The submodule's vendored copy of core. Source of truth is the nested compose.mk/compose.mk; the .cmk copy must never be read as source nor edited. (The nested path lacks the .cmk prefix, so it stays fully accessible.)",
        "use": "compose.mk/compose.mk"
      },
      {
        "path": ".cmk/",
        "mode": "no-restructure",
        "exempt": ["scratch/iso/", ".claude/worktrees/"],
        "why": "The tracked .cmk submodule: edit its files in place with Edit/Write, but never restructure its tree from the shell (rm/mv/cp of the real submodule). Worktree copies are exempt.",
        "use": ".cmk files via Edit/Write; worktree copies under scratch/iso or .claude/worktrees are exempt"
      }
    ]
  },

  // hyg: line-count and syntax defaults restored per matt, 2026-08-21; only shout_ok stays widened for doc-block vocabulary. See scratch/csop-hyg-doc-blocks.md
  "hyg": {
    "shout_ok": ["CSOP", "SOP", "CLI", "API", "URL", "JSON", "HTML", "HTTP", "ID",
                 "ANSI", "SGR", "OSC", "UTF", "ASCII", "JIT", "WIP", "TODO", "FIXME",
                 "NOTE", "OK", "SSOT", "MCP", "VM", "README", "LICENSE",
                 "BEGIN", "END", "DOCS", "USAGE", "NB", "WARNING", "TUI", "DIND",
                 "OSX", "GNU", "POSIX", "CMK", "REPL", "PATH", "XDG", "EOF", "PID",
                 "SIGINT", "SIGTERM", "MAKE", "MAKEFILE", "MAKEFLAGS", "MAKELEVEL",
                 "HOSTED", "DAG", "DAGS", "AWK", "SED", "JQ", "YQ", "JB", "LHS",
                 "RHS", "JSONL", "ERE", "IR", "UI", "CI", "IO", "TRACE", "TERM",
                 "SHELL", "HOME", "YAML", "TTY", "DSL", "TOML", "CSS", "SVG",
                 "PHONY", "PREFIX", "SRC", "DIR", "ENV", "STDIN", "STDOUT",
                 "STDERR", "RECEIVERS", "JUNCTIONS", "GUEST", "SERVICES",
                 "PAYLOAD", "SECTION", "NDJSON",
                 // demo vocabulary, 2026-08-24: acronyms and proper nouns
                 "BEAM", "ABC", "CEK", "MRO", "DFS", "LIFO", "FFI", "FQN",
                 "ETL", "RAG", "OOP", "PEP", "ETAPS", "FTA", "LME", "UNSAT",
                 "JS", "JPEG", "WM", "FD", "IDEAS",
                 // literal syntax: dockerfile instructions and trap names
                 "FROM", "RUN", "COPY", "ENTRYPOINT", "CHMOD",
                 "INT", "EXIT", "DEBUG", "TRUE", "FALSE",
                 // env vars and stage names read verbatim from usage lines
                 "TARGET", "WORKERS", "DELAY", "SPACE", "SEED", "POOL", "NQ",
                 "PIPELINE", "INPUT", "WHO", "GREETING", "WORLD", "BOOM",
                 "BUILD", "REFS",
                 // metasyntactic placeholders in grammar synopses
                 "NAME", "KIND", "VAR", "LIST", "BODY", "CLASS", "CONFIG",
                 "IMG", "IMAGE", "MIXIN", "INFO"]
  },

  // techwrite carries em-dash ban plus code-in-prose for docs; supersedes the docs_prose_gate hook
  "techwrite": {
    "default_enabled": true,
    "prose_globs": ["docs/*.md.j2"],
    "exempt": ["quickref.md.j2"],
    "prose_rules": [
      { "pattern": "\\$[({]", "message": "make/shell expansion in doc prose; put runnable code in a fenced block, a {{ macro }}, or a demo, not a paragraph" },
      { "pattern": " := ", "message": "make assignment (:=) in doc prose; move it into a fenced example" },
      { "pattern": "(?<![\\w.])(?:self|this)\\.\\w", "message": "bare self./this. anchor in doc prose; name the construct in words instead of pasting a snippet" },
      { "pattern": "`[^`\\n]*\\$[({]", "in_spans": true, "message": "expansion wrapped in a backtick span; a code span is not an escape hatch, use a fenced example" },
      { "pattern": "`\\s*(?:self|this)\\.\\w", "in_spans": true, "message": "self./this. anchor in a backtick span; name the construct in words or use a fenced example" }
    ]
  },

  // file-hooks: post-edit reminders and per-type linters; replaces the j2_render_reminder hook
  "file-hooks": {
    "default_enabled": true,
    "types": [
      { "match": ["docs/*.md.j2"],
        "reminder": "The baked .md for this page is now stale. Regenerate exactly this page: run make docs.render/ on the .md.j2 path shown above. Never the full docs sweep (it builds every page including the heavy api page in a detached container)." },
      { "match": ["*/macros/*.j2", "*/includes/*.j2", "*/theme/*.j2"],
        "reminder": "You edited a shared docs partial; no single page owns it. Re-render each importing page with make docs.render on its .md.j2 path, never the full sweep." },
      { "match": ["demos/cmk/*.cmk"], "command": "cmk lint {file}" },
      { "match": ["demos/*.mk"], "command": "./compose.mk mk.validate/{file}" }
    ]
  },

  // idiom on by default here; nudge appends this repo's .cmk house style to the code defaults.
  "idiom": {
    "default_enabled": true,
    "nudge": [
      "In .cmk files: prefer callforms; import log rather than reimplementing logging; do not prefix recipe commands with '@'; write targets as multiline recipes.",
      "In .cmk files: `$(eval $(call ...))` is never idiomatic, and double-dollar ($$) forms are not idiomatic; reach for callforms and the framework's constructs instead."
    ],
    "reject": [
      { "pattern": "^ +@(?!#)", "message": ".cmk recipe command prefixed with @ (cmk runs recipes silent; drop the @)" },
      { "pattern": "^[A-Za-z_][A-Za-z0-9._/%-]*[ \\t]*:[^=]*;", "message": "single-line target; write a multiline recipe under the target header" }
    ]
  },

  // Promotion flow from demo through module to core; off by default, so docs and unclassified paths stay writable from any stage.
  "pro": {
    "default_enabled": false
  },
  "stages": {
    "demo": {
      "default_stage": true,
      "globs": ["demos/**"],
      "post": "Demo `{file}` changed: run it to confirm the idea holds before promoting."
    },
    "module": {
      "globs": [".cmk/**", ".automation.cmk"],
      "from": ["demo"],
      "pre":  { "text": "Promoting to a module: does `{file}` earn reuse? give it a namespace and a home under `.cmk/`. Spike risky bits in scratch/iso first.", "action": "nudge" },
      "post": "Module `{file}` changed: re-run its demo and the curated test set (never the full sweep)."
    },
    "core": {
      "globs": ["compose.mk", "tests/**"],
      "from": ["module", "demo"],
      "writable": ["**"],
      "pre":  { "text": "Core edit (`{file}`): land the behavior via a demo/module or a scratch/iso spike first, then fold it in. Keep consolidations net-negative.", "action": "nudge" },
      "post": "compose.mk changed: run the curated ~176-test set, not the full sweep; `flux.ok` for a fast signal."
    }
  }
}
