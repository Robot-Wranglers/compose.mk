## File Previews
{#░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░#}
{# embed_body: the inner code area (back-to-top anchor + <details> code block + bottom bar).
   ONE source of truth, shared by the SOLO one-tab mirror (embed_demo top=True) AND every
   embed_mirror pane (embed_demo top=False).  `.cmk` files render with the real `cmk` Prism
   grammar (extends makefile); plain `.mk` use the makefile base. #}
{% macro embed_body(fname, link_prefix, github={}, type='Makefile', title='', bottom_middle='', bottom_right='', extra_label='', class="", collapsed=False)-%}<a id="{{link_prefix}}_top"></a><details id="{{link_prefix}}_details"{% if not collapsed %} open{% endif %}><summary{% if collapsed %} class="embed-collapse-summary"{% else %} style="display:none;"{% endif %}>{% if collapsed %}Show / hide source{% else %}Summary{% endif %}</summary>
{#- lead with `cmk` for .cmk files: Prism resolves an element's language from the FIRST
    `language-*` class, so `cmk` must precede `Makefile`; otherwise .cmk embeds highlight
    with the makefile base grammar and lose every cmk-only token (named-bananas, decl heads). #}
```{{ 'cmk' if fname.endswith('.cmk') else type }} {%raw%}{{%endraw%}{{class}} {{ '.language-' + ('cmk' if fname.endswith('.cmk') else type) }}{%raw%}}{%endraw%}
{{open(fname,'r').read().strip()}}
```
</details>{{macros.code_table_bottom(fname, bottom_middle=bottom_middle, bottom_right=bottom_right, extra_label=extra_label, title=title, link_prefix=link_prefix, type=type, github=github, class=class)}}<a id="{{link_prefix}}_bottom"></a><br/>{%- endmacro -%}

{# embed_demo: a SOLO file preview.  Now unified with embed_mirror; it renders as a
   ONE-TAB `code_mirror` (identical tab-row + pane chrome, minus the radio toggle; the
   single pane is always shown).  top=False yields the bare body for use inside a mirror
   pane.  (The old `code_table_top` bar is retired for embeds; code_table stays for its
   other callers.) #}
{% macro embed_demo(fname, github={},
    bottom_middle='', bottom_right='',
    type='Makefile', title='',
    extra_label='', class="", top=True, collapsed=False)-%}{% set link_prefix=macros.normalize_fname(fname) %}<a id="{{link_prefix}}"></a>{%- if top -%}<div class="code_mirror code_mirror_solo {{class}}" id="{{link_prefix}}__mirror"><div class="mirror_tabs" role="tablist"><span class="mirror_tab mirror_tab_active" role="tab">{% if fname.endswith('.cmk') %}cmk-lang{% else %}{{type|default('notype')}}{% endif %}</span><a class="mirror_src" href="{{macros.repo_url(fname, github=github)}}" title="Project Source: {{fname}}" target="_blank" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" /></svg><span class="mirror_src_name">{{macros.demo_label(fname)}}</span></a></div>
<div class="mirror_pane" role="tabpanel">
{{ embed_body(fname, link_prefix, github=github, type=type, title=title, bottom_middle=bottom_middle, bottom_right=bottom_right, extra_label=extra_label, class=class, collapsed=collapsed) | trim }}
</div>
</div>
{%- else -%}
{{ embed_body(fname, link_prefix, github=github, type=type, title=title, bottom_middle=bottom_middle, bottom_right=bottom_right, extra_label=extra_label, class=class, collapsed=collapsed) | trim }}
{%- endif -%}
{%- endmacro -%}

{# embed_mirror: like `embed_demo`, but for a TWIN pair, e.g. a plain `Makefile` and
   its `cmk-lang` equivalent.  Instead of embedding one and LINKING to the other (the
   `embed_demo(..., bottom_right=link_mirror(..))` pattern), it embeds BOTH in a single
   widget with a CSS-only tab toggle; `default` ('left'|'right', or 'cmk'|'mk') picks the
   pane shown first.  Styling/markup contract lives in `.code_mirror` (compose.mk.css).
   `left`/`right` are the two file paths (order = tab order). #}
{% macro embed_mirror(left, right, github={}, default='left', type_left='Makefile', type_right='cmk', class='', see_also='', see_also_text='See also')-%}
{%- set gid = 'mirror_' + macros.normalize_fname(left) + '__' + macros.normalize_fname(right) -%}
{%- set label_left = 'cmk-lang' if left.endswith('.cmk') else 'Plain Makefile' -%}
{%- set label_right = 'cmk-lang' if right.endswith('.cmk') else 'Plain Makefile' -%}
{%- set right_default = default in ['right', right] or (default == 'cmk' and right.endswith('.cmk')) or (default == 'mk' and right.endswith('.mk')) -%}
<div class="code_mirror{% if right_default %} mirror_lead_R{% endif %} {{class}}" id="{{gid}}">
<input type="radio" class="mirror_toggle mirror_toggle_L" name="{{gid}}" id="{{gid}}__L"{% if not right_default %} checked{% endif %}>
<input type="radio" class="mirror_toggle mirror_toggle_R" name="{{gid}}" id="{{gid}}__R"{% if right_default %} checked{% endif %}>
<div class="mirror_tabs" role="tablist">
<label class="mirror_tab mirror_tab_L" for="{{gid}}__L" role="tab">{{label_left}}</label>
<label class="mirror_tab mirror_tab_R" for="{{gid}}__R" role="tab">{{label_right}}</label>
<a class="mirror_src mirror_src_L" href="{{macros.repo_url(left, github=github)}}" title="Project Source: {{left}}" target="_blank" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" /></svg><span class="mirror_src_name">{{macros.demo_label(left)}}</span></a>
<a class="mirror_src mirror_src_R" href="{{macros.repo_url(right, github=github)}}" title="Project Source: {{right}}" target="_blank" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" /></svg><span class="mirror_src_name">{{macros.demo_label(right)}}</span></a>
</div>
<div class="mirror_pane mirror_pane_L" role="tabpanel">
{{ embed_demo(left, github=github, type=type_left, top=False) | trim }}
</div>
<div class="mirror_pane mirror_pane_R" role="tabpanel">
{{ embed_demo(right, github=github, type=type_right, top=False) | trim }}
</div>
{%- if see_also %}
<div class="mirror_see_also">See also: <a href="{{see_also}}">{{see_also_text}}</a></div>
{%- endif %}
</div>
{%- endmacro -%}

