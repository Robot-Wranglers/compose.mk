{# contract_card: a reusable "contract" panel -- a titled card that lays out the SHAPE of an
   interface as simple `<b>label</b>: gloss` paragraphs (one per rule).  Reach for it wherever
   a doc would otherwise hand-roll a "here are the naming / arity rules" bullet list.  `rows` =
   list of `[label, desc]` pairs: `label` is emitted as an auto-escaped bold monospace token
   (so `<name>` placeholders survive as literal text), `desc` is inline HTML -- this renders as
   a raw-HTML block, so python-markdown does NOT process markdown inside it; write
   `<code>`/`<b>`/`<i>`, not backticks / `**` / `_`.  `subject` = the MAIN LABEL: the API / entity this is the
   contract *for* (e.g. `cli.subcommands.enter`), rendered in the header so the reader always
   knows what the rules govern; the muted kind-tag `title` (default `contract`) prints BEFORE
   it.  Pass `link` to make the subject a hyperlink (e.g. into `/api/#..`); without it the
   subject is an inert monospace chip.  The card gets a stable `id` (default
   `contract_<subject>`, dots / slashes -> `_`) so it can be deep-linked; override via `id`.
   Optional `note` = an HTML footer caption for behaviour that doesn't fit a single row (e.g.
   dispatch semantics).  Kept blank-line-free so python-markdown passes the whole div through
   as one raw-HTML block.  Styling: `.contract_card` (compose.mk.css), sharing the
   `.related_api` card chrome. #}
{% macro contract_card(rows, subject='', link='', title='contract', note='', id='')-%}
{%- set cid = id if id else ('contract_' + subject.replace('.','_').replace('/','_').replace(' ','_') if subject else '') -%}
<div class="contract_card"{% if cid %} id="{{cid}}"{% endif %}><div class="contract_card_header"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2" /><path d="M9 3m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z" /><path d="M9 12l.01 0" /><path d="M13 12l2 0" /><path d="M9 16l.01 0" /><path d="M13 16l2 0" /></svg>{% if subject %}<span class="contract_card_kind">{{title}}</span>{% if link %}<a class="contract_card_subject" href="{{link}}">{{subject}}</a>{% else %}<code class="contract_card_subject">{{subject}}</code>{% endif %}{% else %}<span class="contract_card_kind_solo">{{title}}</span>{% endif %}</div>{% for label, desc in rows %}<p class="contract_row"><b class="contract_row_label">{{ label|e }}</b>: {{ desc }}</p>{% endfor %}{% if note %}<div class="contract_card_note">{{ note }}</div>{% endif %}</div>
{%- endmacro -%}


# API links
{#░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░#}

{% macro api_link(target, mkdocs, arg='',style="") -%}{%set link=target.replace('-','').replace('.','').replace('/','').replace('&lt;','').replace('&gt;','').replace('<','').replace('>','')%}{%if arg%}{%set name=target.replace('/&lt;arg','').replace('&gt;','').replace('/<arg','').replace('>','') + '/&lt;'+arg+'&gt;'%}{%set link=link+'arg' if not link.endswith('arg') else link %}{%else%}{%set name=target%}{%endif%} <a style="{{style}}" href="{{mkdocs.site_relative_url}}/api/#{{link}}" >{{name}}</a>{%- endmacro -%}

{# Related-API widget: a self-contained card linking into the main /api docs.  Instead of
   a one-row-per-target table (sparse + unwieldy), it reflects the matching targets from
   compose.mk and renders them as a single WRAPPED, comma-separated list of links, under an
   `<icon> Related API` header plus a caption naming the filter that generated it.  Styling
   lives in `.related_api` (compose.mk.css); the markup is kept blank-line-free so
   python-markdown passes the whole div through as one raw-HTML block. #}
{% macro api_link_many(target_fam, mkdocs, arg='', exclude='None') -%}
{%- set ns = namespace(links=[]) -%}
{%- for target_f in target_fam -%}
{%- set targets = bash('mk.parse targets compose.mk --names-only --prefix '+target_f) -%}
{%- if targets -%}{%- for target in targets.split('\n') -%}
{%- set target = target.strip().replace('%','&lt;arg&gt;') -%}
{%- if target and not target.startswith(exclude) -%}{%- set _ = ns.links.append(api_link(target, mkdocs, arg=arg)|trim) -%}{%- endif -%}
{%- endfor -%}{%- endif -%}
{%- endfor -%}
<div class="related_api"><div class="related_api_header"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-map-2"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 18.5l-3 -1.5l-6 3v-13l6 -3l6 3l6 -3v7.5" /><path d="M9 4v13" /><path d="M15 7v5.5" /><path d="M21.121 20.121a3 3 0 1 0 -4.242 0c.418 .419 1.125 1.045 2.121 1.879c1.051 -.89 1.759 -1.516 2.121 -1.879z" /><path d="M19 18v.01" /></svg><span>Related API</span></div><div class="related_api_filter">reflected from <code>compose.mk</code> by prefix {% for tf in target_fam %}<code>{{tf}}</code>{{ ", " if not loop.last else "" }}{% endfor %}{% if exclude and exclude != 'None' %} <span class="related_api_excl">(excluding <code>{{exclude}}</code>)</span>{% endif %}</div>{% if ns.links %}<div class="related_api_links">{{ ns.links|join(', ') }}</div>{% else %}<div class="related_api_empty">No targets matched.</div>{% endif %}</div>
{%- endmacro -%}

# CMK-Specific
{#░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░#}
{% macro link_mirror(fname='',link='',base='')-%}{%set default_link=base+"#"+macros.normalize_fname(fname)%}Alternate Syntax: <a href="{{link or default_link}}">{%if fname.endswith('cmk')%}CMK-Lang{%else%}Plain Makefile{%endif%} Equivalent </a><small>✔️</small>{%- endmacro -%}


{# Renders the `## BEGIN: <pattern>` doc-block from compose.mk as markdown.
   The cblock body (prose + any markdown table) is emitted verbatim; the caller
   supplies the surrounding heading.  See e.g. the `DeclarationIndex` block.
   NB: extracted with awk, NOT the dockerized `lang.parse.doc_block`; the docs render
   runs inside a container with no nested docker, where mkparse returns "failed". #}
{% macro block_docs(pattern, mkdocs=None, arg='', caption=True) -%}
{%- set cmd = 'awk \'/^## BEGIN: ' + pattern + '/{f=1;next} f{if($0~/^## END:/ || ($0!~/^## / && $0!="##"))exit;sub(/^## ?/,"");print}\' compose.mk' -%}
{{ bash(cmd) }}
{% if caption %}<center><small><i>Generated from the `{{pattern}}` doc-block in `compose.mk`</i></small></center>{% endif %}
{%- endmacro -%}

{# ── Signature rendering ──────────────────────────────────────────────────
   `signature(spec)` styles one arglist/optlist synopsis (the "brings into
   scope" mini-notation used by the Declaration Family, e.g.
   `def=<name>|file=<path> [namespace=] [strict=0 -> log+continue]`).

   The grammar it recognises, and the class each token maps to:
     name=      required key ...................... .sig-key + .sig-op (the `=`)
     <name>     placeholder / metavariable ........ .sig-ph   (`..` marks variadic)
     [ ... ]    optional group (brackets dropped, .. .sig-opt  (CSS re-adds `[ ]`)
                re-added by CSS so nesting styles)
     |          alternation ...................... .sig-op.sig-alt
     ->         effect annotation ................ .sig-op.sig-arrow
     ( ... )    parenthetical note ............... .sig-note

   Implementation: a small ordered chain of `re.sub`, built once via the
   `eval` jinja-global (the same escape-hatch `bash`/`block_docs` lean on).
   Keys are matched FIRST, before any `class="..."` is injected, so the key
   regex never re-matches an attribute inside a span we just emitted. HTML is
   escaped up front; the injected `<span>`s are the only live tags.  Styling
   lives in `.sig*` (docs/theme/css/compose.mk.css). #}
{%- set _sig = eval(
  "(lambda re, html: (lambda s: '<code class=\"sig\">' + "
  "re.sub(r'\\[([^\\[\\]]*)\\]', lambda m:'<span class=\"sig-opt\">'+m.group(1)+'</span>', "
  "re.sub(r'\\(([^)]*)\\)', lambda m:'<span class=\"sig-note\">('+m.group(1)+')</span>', "
  "re.sub(r'-&gt;', lambda m:'<span class=\"sig-op sig-arrow\">-&gt;</span>', "
  "re.sub(r'&lt;([^&]*?)&gt;', lambda m:'<span class=\"sig-ph\">&lt;'+m.group(1)+'&gt;</span>', "
  "re.sub(r'([A-Za-z_][\\w.]*)=', lambda m:'<span class=\"sig-key\">'+m.group(1)+'</span><span class=\"sig-op\">=</span>', "
  "html.escape(s, False))))).replace('|','<span class=\"sig-op sig-alt\">|</span>')) + '</code>'"
  "))(__import__('re'), __import__('html'))"
) -%}
{% macro signature(spec) -%}{{ _sig(spec) }}{%- endmacro -%}

{# `signature_legend()`: a one-line key for the tokens above, rendered from
   the same component so the legend can never drift from the real styling. #}
{% macro signature_legend() -%}
<div class="sig-legend">
  {{ signature('name=') }} required
  {{ signature('<value>') }} placeholder
  {{ signature('[opt=]') }} optional
  {{ signature('a|b') }} either
  {{ signature('->') }} effect
</div>
{%- endmacro -%}

