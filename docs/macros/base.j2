{#- ─── Link-list admonitions ──────────────────────────────────────────────────
    Two normalized "connections to other pages" callouts:
      * road_map(...)      -- a TOP-of-page "Road Map" escape hatch (road_map
                              admonition + road-map icon), for readers who may
                              have landed in the wrong place.
      * related_links(...) -- a BOTTOM-of-page "Where to from here?" sweep-up of
                              onward connections (related_links admonition).
    Both take the same arguments:
      items    -- a list; each entry is either a full-sentence string (rendered
                  verbatim as one bullet) or a `[label, link]` / `[label, link,
                  note]` pair/triple (rendered as `[label](link): note`).
      mkdocs   -- the mkdocs context (needed for `@/` expansion).
      preamble -- optional lead line shown above the list.
      title    -- overrides the default header ("Road Map" / "Where to from here?").
    In ANY string (a sentence, a link, a note, the preamble), `@/foo` expands to
    the site-relative `{{mkdocs.site_relative_url}}/foo`.  Absolute URLs (http, a
    Jinja var, `#anchor`) are passed through untouched. ──────────────────────── #}
{% macro _ll_expand(s, mkdocs) -%}{{ s.replace('@/', mkdocs.site_relative_url ~ '/') }}{%- endmacro -%}
{% macro _ll_item(item, mkdocs) -%}
{%- if item is string -%}{{ _ll_expand(item, mkdocs) }}{%- else -%}[{{ item[0] }}]({{ _ll_expand(item[1], mkdocs) }}){% if item|length > 2 %}: {{ _ll_expand(item[2], mkdocs) }}{% endif %}{%- endif -%}
{%- endmacro -%}
{% macro _link_admonition(kind, title, items, mkdocs, preamble='', marker='!!!') -%}
{{ marker }} {{ kind }} "{{ title }}"
{% if preamble %}    {{ _ll_expand(preamble, mkdocs) }}

    &nbsp;

{% endif %}{% for item in items %}    * {{ _ll_item(item, mkdocs) }}
{% endfor %}
{%- endmacro -%}
{% macro road_map(items, mkdocs, preamble='', title='Road Map') -%}
{{ _link_admonition('road_map', title, items, mkdocs, preamble=preamble) }}
{%- endmacro -%}
{#- escape_hatch renders as a collapsible details: the summary toggles on any header click, and the
    permalink/toast handler skips <summary> titles so it stays a plain open/close.  `open=false`
    (default) starts it collapsed (`???`); `open=true` starts it expanded (`???+`). #}
{% macro escape_hatch(items, mkdocs, preamble='', title='Escape Hatch', open=false) -%}
{{ _link_admonition('escape_hatch', title, items, mkdocs, preamble=preamble, marker=('???+' if open else '???')) }}
{%- endmacro -%}
{% macro related_links(items, mkdocs, preamble='', title='Where to from here?') -%}
{{ _link_admonition('related_links', title, items, mkdocs, preamble=preamble) }}
{%- endmacro -%}
{#- see_also(...): a subtle, NEUTRAL-toned cousin of related_links; for the inline
    "See also" cross-reference callouts that punctuate a section (vs the page-bottom
    onward sweep).  Same item format (`@/` links, `[label, link, note]` triples). #}
{% macro see_also(items, mkdocs, preamble='', title='See also') -%}
{{ _link_admonition('see_also', title, items, mkdocs, preamble=preamble) }}
{%- endmacro -%}

