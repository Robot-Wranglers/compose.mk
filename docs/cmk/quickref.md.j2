{{ macros.section(3, "Reflection", id="reflection") }}

<table class=quickref>
  <thead>
    <tr>
      <th>Operator</th>
      <th>Syntax / Example</th>
      <th>Meaning</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><a href="{{_}}/cmk/metaprogramming/#about-dialects">Target Name</a></td>
      <td><code>__target_name__</code><br/><code>cmk.log(__target_name__)</code></td>
      <td>The running target's own name (alias for <code>${@}</code>).</td>
    </tr>
    <tr>
      <td><a href="{{_}}/cmk/pragmas/#pragma-target_locals">Target Locals</a></td>
      <td><code>__locals__()</code><br/><code>j <- cmk.__locals__()</code></td>
      <td>JSON object of the vars THIS recipe defined (current shell vars minus a baseline taken at recipe entry; captures <code><-</code> vars and <code>export</code>s alike).  Needs the <code>target_locals</code> compile pragma.  It is a shell snippet, so use it via <code><-</code> or backticks, not as a bare arg.</td>
    </tr>
  </tbody>
</table>

