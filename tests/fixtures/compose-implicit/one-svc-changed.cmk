#!/usr/bin/env -S ./compose.mk cmk run

# The one-svc program with a different marker, same service and stem.

from cmk import Dockerfile

Dockerfile probe_base(|
  FROM alpine:3.21.2
  RUN true
|)

export IMG_PROBE := $(probe_base.img)

compose.import.string probe.services(|
services:
  solo:
    build:
      context: .
      dockerfile_inline: |
        FROM ${IMG_PROBE}
        RUN echo changed > /marker
    entrypoint: sh
|)

__main__:
    true
