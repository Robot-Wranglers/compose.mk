#!/usr/bin/env -S ./compose.mk cmk run

# One buildable base plus a service on top, the shape every gui demo uses.

from cmk import Dockerfile

Dockerfile probe_base(|
  FROM alpine:3.21.2
  RUN true
|)

export IMG_PROBE := $(probe_base.img)

compose.import.string probe.services(|
services:
  solo:
    build:
      context: .
      dockerfile_inline: |
        FROM ${IMG_PROBE}
        RUN echo solo > /marker
    entrypoint: sh
|)

__main__:
    true
